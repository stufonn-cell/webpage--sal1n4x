#!/usr/bin/env bash
#
# PsiClinic - controls the application on WSL or Linux.
# Made by Salinas | github.com/stufonn-cell
#
# Usage: psiclinic [up|down|restart|status|logs|build|install|test|test-front|shell|db|backup|open|help]

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"

APP_PORT="$(grep -E '^APP_PORT=' .env 2>/dev/null | cut -d= -f2 | tr -d '[:space:]' || true)"
APP_PORT="${APP_PORT:-8080}"

log() { printf '  %s\n' "$1"; }

require_env() {
    if [ ! -f .env ]; then
        log "There is no .env file. Copying it from .env.example."
        cp .env.example .env
        log "Review the passwords and keys in .env before using it with real data."
    fi
}

wait_for_database() {
    log "Waiting for MySQL to respond..."
    for _ in $(seq 1 45); do
        if docker compose exec -T mysql mysqladmin ping -h 127.0.0.1 --silent >/dev/null 2>&1; then
            log "MySQL is ready."
            return 0
        fi
        sleep 2
    done
    log "MySQL did not respond in time. Check: docker compose logs mysql"
    return 1
}

command_build() {
    log "Building the frontend..."
    docker compose run --rm --no-deps frontend sh -c "npm install --no-audit --no-fund && npm run build"
    log "Frontend built in frontend/dist."
}

command_up() {
    require_env
    if [ ! -f frontend/dist/index.html ]; then
        command_build
    fi
    log "Starting the containers..."
    docker compose up -d
    wait_for_database
    docker compose exec -T app php bin/console migrate >/dev/null
    log "PsiClinic is running at http://localhost:${APP_PORT}"
    log "Frontend with hot reload at http://localhost:5173"
}

command_down() {
    docker compose down
    log "Containers stopped. Your data is kept."
}

command_status() {
    docker compose ps
}

command_open() {
    local url="http://localhost:${APP_PORT}"
    if command -v explorer.exe >/dev/null 2>&1; then
        explorer.exe "$url" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 || true
    else
        log "Open it manually: $url"
    fi
}

command_backup() {
    local file="backup-$(date +%F-%H%M).sql.gz"
    local root_password
    root_password="$(grep -E '^DB_ROOT_PASSWORD=' .env | cut -d= -f2)"
    local database
    database="$(grep -E '^DB_DATABASE=' .env | cut -d= -f2)"

    docker compose exec -T mysql mysqldump -u root -p"$root_password" --single-transaction "$database" | gzip > "$file"
    log "Backup created: $file"
}

case "${1:-up}" in
    up)       command_up ;;
    down)     command_down ;;
    restart)  command_down; command_up ;;
    status)   command_status ;;
    logs)     docker compose logs -f app web frontend ;;
    build)    command_build ;;
    install)  require_env; command_build; docker compose up -d; wait_for_database; docker compose exec app php bin/console install ;;
    test)     docker compose exec app php bin/test "${2:-}" ;;
    test-front) docker compose run --rm --no-deps frontend sh -c "npm install --no-audit --no-fund && npm run typecheck && npm test" ;;
    shell)    docker compose exec app sh ;;
    db)       docker compose exec mysql mysql -u root -p"$(grep -E '^DB_ROOT_PASSWORD=' .env | cut -d= -f2)" ;;
    backup)   command_backup ;;
    open)     command_open ;;
    *)
        cat <<'HELP'
  PsiClinic - available commands

    psiclinic up         Starts the containers and applies pending migrations
    psiclinic down       Stops the containers and keeps the data
    psiclinic restart    Restarts everything
    psiclinic status     Shows the status of the containers
    psiclinic logs       Follows the PHP, Nginx and Vite logs
    psiclinic build      Builds the frontend (frontend/dist)
    psiclinic install    First install with demo data
    psiclinic test       Runs the backend test suite
    psiclinic test-front Checks types and runs the frontend tests
    psiclinic shell      Opens a shell inside the PHP container
    psiclinic db         Opens the MySQL client
    psiclinic backup     Creates a compressed dump of the database
    psiclinic open       Opens the application in the browser
    psiclinic help       Shows this list
HELP
        ;;
esac
