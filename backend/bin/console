#!/usr/bin/env php
<?php

declare(strict_types=1);

use PsiClinic\Core\Env;
use PsiClinic\Support\Installer;

require dirname(__DIR__) . '/src/autoload.php';

Env::load(dirname(__DIR__) . '/.env');
date_default_timezone_set((string) Env::get('APP_TIMEZONE', 'UTC'));

$availableCommands = [
    'install' => 'Runs the migrations and loads the demo data',
    'migrate' => 'Creates the tables from database/migrations',
    'icd11' => 'Reloads the ICD-11 catalog from database/data',
    'seed' => 'Loads only the demo data',
    'fresh' => 'Drops every table and reinstalls from scratch',
    'key' => 'Generates a value for APP_KEY',
    'hash' => 'Generates a password hash: bin/console hash MyPassword',
];

$command = $argv[1] ?? 'help';

try {
    match ($command) {
        'install' => Installer::install(),
        'migrate' => Installer::migrate(),
        'icd11' => Installer::importIcd11(),
        'seed' => Installer::seed(),
        'fresh' => Installer::fresh(),
        'key' => print base64_encode(random_bytes(32)) . PHP_EOL,
        'hash' => print password_hash((string) ($argv[2] ?? ''), PASSWORD_DEFAULT) . PHP_EOL,
        default => Installer::printHelp($availableCommands),
    };
} catch (Throwable $exception) {
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}

exit(0);
