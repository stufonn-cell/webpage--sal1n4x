# ---------------------------------------------------------------------------
# PsiClinic - environment settings
# Copy to .env and adjust. The .env file is never pushed to the repository.
# ---------------------------------------------------------------------------

# Application
APP_NAME="PsiClinic"
APP_ENV=local                # local | production (demo accounts are not listed in production)
APP_DEBUG=true               # false in production
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota

# 32-byte key in base64. Generate it with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Database (matches the mysql service in docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=psiclinic
DB_USERNAME=psiclinic
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password
DB_CHARSET=utf8mb4

# Database used by the test suite (php bin/test).
# It is created automatically when the MySQL container starts.
DB_TEST_DATABASE=psiclinic_test

# Ports published on the host
APP_PORT=8080
ADMINER_PORT=8081
FRONTEND_PORT=5173          # Vite development server
DB_EXTERNAL_PORT=3307

# Session and security
SESSION_NAME=psiclinic_session
SESSION_LIFETIME=7200        # seconds of inactivity before signing out
SESSION_ABSOLUTE_LIFETIME=43200  # sign out 12 hours after signing in, even if active
SESSION_SECURE=false         # true when served over HTTPS (default true in production)
SESSION_SAMESITE=Strict      # Strict | Lax
LOGIN_MAX_ATTEMPTS=5         # failed attempts per account before the lockout
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_BCRYPT_COST=12      # 10 to 15; existing hashes are upgraded at the next sign-in
API_MAX_JSON_BYTES=1048576   # largest JSON body accepted (1 MB)

# Rate limits ("<requests>/<seconds>", or "off"). Counters live in MySQL
# (table rate_limits). They are always off while the test suite runs.
# Nginx adds its own per-IP limits in front (docker/nginx/default.conf).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=600/60            # every API route, per IP
RATE_LIMIT_LOGIN=10/60           # POST /api/auth/login, per IP
RATE_LIMIT_PUBLIC_FORM=10/3600   # public appointment request form, per IP
RATE_LIMIT_SEARCH=60/60          # global search, per user
RATE_LIMIT_ICD11=60/60           # ICD-11 lookup, per user
RATE_LIMIT_UPLOAD=30/600         # document uploads, per user
RATE_LIMIT_RIPS_SEND=6/600       # sending RIPS to the validator, per user
RATE_LIMIT_PROFILE=20/600        # profile and password changes, per user

# Files
UPLOAD_MAX_SIZE=10485760     # 10 MB in bytes (keep php.ini and Nginx in line)
UPLOAD_PATH=storage/uploads

# Email (optional, for appointment reminders)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@psiclinic.local
MAIL_FROM_NAME="PsiClinic"
