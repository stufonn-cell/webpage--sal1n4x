# ---------------------------------------------------------------------------
# PsiClinic - configuracion de entorno
# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# Aplicacion
APP_NAME="PsiClinic"
APP_ENV=local                # local | production (en produccion no se anuncian cuentas demo)
APP_DEBUG=true               # false en produccion
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Clave de 32 bytes en base64. Generar con:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Base de datos (coincide con el servicio mysql de docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=psiclinic
DB_USERNAME=psiclinic
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_CHARSET=utf8mb4

# Base de datos usada por la suite de pruebas (php bin/test).
# Se crea automaticamente al levantar el contenedor de MySQL.
DB_TEST_DATABASE=psiclinic_test

# Puertos publicados en el host
APP_PORT=8080
ADMINER_PORT=8081
FRONTEND_PORT=5173          # servidor de desarrollo de Vite
DB_EXTERNAL_PORT=3307

# Sesion y seguridad
SESSION_NAME=psiclinic_session
SESSION_LIFETIME=7200        # segundos de inactividad antes de cerrar la sesion
SESSION_SECURE=false         # true cuando se sirva por HTTPS
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Archivos
UPLOAD_MAX_SIZE=10485760     # 10 MB en bytes
UPLOAD_PATH=storage/uploads

# Correo (opcional, para recordatorios de cita)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@psiclinic.local
MAIL_FROM_NAME="PsiClinic"
